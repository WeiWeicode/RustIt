# ItAgentBack 測試區 Compose 變數範本(複製到主機 2 的 /srv/giganexus/deploy/ita.env;不入版控)
GW_ENV=test
GW_BASE_URL=https://giganexus-test.gigasolar.com.tw
GW_NETWORK=giganexus-gw_default
# Gateway Docker 網段(docker network inspect giganexus-gw_default;主機 2 為 172.19.0.0/16)
AGENT_TRUSTED_PROXIES=172.19.0.0/16
# 開發與測試區共用 giganexus_It_Agent_test(migration 由開發者電腦 npm run db:migrate 套用)
ITA_DB_HOST=10.10.130.220
ITA_DB_NAME=giganexus_It_Agent_test
ITA_DB_USER=ita_app
# 主機下發給 Agent 的設定(選填,預設 3600 秒 / 回報 USB 事件);回報同時處理上限與 429 等待秒數(選填)
# AGENT_INVENTORY_INTERVAL_SEC=3600
# AGENT_USB_EVENTS=1
# AGENT_MAX_INFLIGHT=32
# AGENT_BUSY_RETRY_AFTER_SEC=30
# 監測(P5,選填):心跳健康摘要開關;告警門檻(離線天數、磁碟剩餘開 / 關 %、24 小時非正常重啟次數、憑證到期天數、Agent 無回應分鐘)
# AGENT_HEALTH_ENABLED=1
# ALERT_OFFLINE_DAYS=7
# ALERT_DISK_FREE_PCT=10
# ALERT_DISK_CLEAR_PCT=15
# ALERT_RESTARTS_24H=3
# ALERT_CERT_DAYS=30
# ALERT_SILENT_MIN=15
# 指令附檔(logs.collect 日誌)保存天數 14–30(選填,預設 14)
# COMMAND_FILE_KEEP_DAYS=14
# 資料範圍(E6):可管理所有公司的角色代碼(逗號分隔;必填,沒有則留空 ENDPOINT_SCOPE_ALL_ROLES=)
ENDPOINT_SCOPE_ALL_ROLES=it-admin
# 網域 → 公司(公司名稱同 Gateway 公司名稱;`公司=網域,網域;公司=網域`,選填,省略 = 不自動判定)
ENDPOINT_COMPANY_DOMAINS=碩禾=gsc.com.tw,gsmc.com.tw;鹽城碩禾=ygdmc.gsc.com.tw
# 升級(P6):版本檔所在的主機目錄(唯讀掛載到容器 /srv/releases;選填,預設 /srv/giganexus/ita-releases)與同時升級上限
# ITA_RELEASES_HOST_DIR=/srv/giganexus/ita-releases
# RELEASE_MAX_CONCURRENT=20
# 機密目錄(uid 1000 可讀):見 docker-compose.yml 開頭
ITA_SECRETS_DIR=/srv/giganexus/ita-secrets
