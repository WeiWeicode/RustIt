# ItAgentBack 測試區 Compose 變數範本(複製到主機 2 的 /srv/giganexus/deploy/ita.env;不入版控)
GW_ENV=test
GW_BASE_URL=https://giganexus-test.gigasolar.com.tw
GW_NETWORK=giganexus-gw_default
# Gateway Docker 網段(docker network inspect giganexus-gw_default;主機 2 為 172.19.0.0/16)
AGENT_TRUSTED_PROXIES=172.19.0.0/16
# 開發與測試區共用 giganexus_It_Agent_test(migration 由開發者電腦 npm run db:migrate 套用)
ITA_DB_HOST=10.10.130.220
ITA_DB_NAME=giganexus_It_Agent_test
ITA_DB_USER=ita_app
# 主機下發給 Agent 的設定(選填,預設 3600 秒 / 回報 USB 事件);回報同時處理上限與 429 等待秒數(選填)
# AGENT_INVENTORY_INTERVAL_SEC=3600
# AGENT_USB_EVENTS=1
# AGENT_MAX_INFLIGHT=32
# AGENT_BUSY_RETRY_AFTER_SEC=30
# 機密目錄(uid 1000 可讀):見 docker-compose.yml 開頭
ITA_SECRETS_DIR=/srv/giganexus/ita-secrets
