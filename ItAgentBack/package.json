{
  "name": "@giganexus/it-agent-back",
  "version": "0.1.0",
  "private": true,
  "description": "RustIt Endpoint Server(Node.js + Fastify):Agent 通道 :51241(HTTPS 回報 + WebSocket)與管理 API :51240(X-Internal-Token);SQL Server 為唯一真相,Mongo 快照歷史、Redis 在線狀態",
  "type": "module",
  "gateway": {
    "project": "RustIt"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/src/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:int": "tsx --env-file-if-exists=.env --test test/int/*.int.test.ts",
    "db:migrate": "tsx --env-file-if-exists=.env src/migrate.ts",
    "openapi": "tsx src/print-openapi.ts"
  },
  "dependencies": {
    "@fastify/swagger": "9.9.1",
    "@fastify/websocket": "11.3.1",
    "@giganexus/backend-sdk": "^0.3.0",
    "ajv": "8.17.1",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.5",
    "ioredis": "6.0.0",
    "mongodb": "6.21.0",
    "mssql": "11.0.2"
  },
  "devDependencies": {
    "@types/mssql": "9.1.11",
    "@types/node": "22.20.4",
    "@types/ws": "8.18.1",
    "jose": "^6.2.12",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "ws": "8.21.3"
  }
}
