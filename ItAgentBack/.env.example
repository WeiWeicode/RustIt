# 複製為 .env(不進版控);部署區差異見 RustIt AGENT.md §6。缺少必要設定時啟動失敗。
# dev:本機開發(不自動註冊)/ test:測試區 / prod:正式區(test、prod 啟動時自動註冊管理 API 為 Gateway 草稿)
GW_ENV=dev
# 管理 API 的服務代碼 = 內部 Token 的 aud(BACKEND-GUIDE §3.3 已登記);不可自行更換
SERVICE_CODE=endpoint-api
# 管理 API(endpoint-api)/ Agent 通道(endpoint-agent);測試區 / 正式區固定 51240 / 51241。
# 本機若被 Windows 保留(netsh int ipv4 show excludedportrange protocol=tcp,常見 51176–51275),dev 改用 51296 / 51297(未分配區段;51291 已登記給 itapp-api,不可用)
PORT=51240
AGENT_PORT=51241
# Gateway 位址(JWKS、自動註冊經此);測試區為主機 2 的 DNS 名稱
GW_BASE_URL=https://giganexus-test.gigasolar.com.tw
# test / prod:GW_API_KEY_FILE=/run/secrets/gw_api_key、SERVICE_ADVERTISE_URL=https://endpoint-server:51240(port 需在 51200–51300)
# GW_API_KEY_FILE=
# SERVICE_ADVERTISE_URL=

# SQL Server 2012(唯一真相;encrypt: false,決策 D8)。開發與測試區共用 giganexus_It_Agent_test
ITA_DB_HOST=10.10.130.220
ITA_DB_PORT=1433
ITA_DB_NAME=giganexus_It_Agent_test
ITA_DB_USER=ita_app
ITA_DB_PASSWORD=
# test / prod 只接受 _FILE:ITA_DB_PASSWORD_FILE=/run/secrets/ita_db_password
# migration(npm run db:migrate)與整合測試(npm run test:int)用的帳號
ITA_MIGRATE_USER=ita_migrate
ITA_MIGRATE_PASSWORD=
# 整合測試專用庫:每次執行會清空 schema ita,不可指向上面的庫
ITA_TEST_DB_NAME=giganexus_It_Agent_poc_test

# MongoDB / Redis(開發用 deploy/docker-compose.dev.yml,只綁 127.0.0.1;密碼與下方 ITA_MONGO_PASSWORD / ITA_REDIS_PASSWORD 相同)
MONGO_URL=mongodb://ita:<ITA_MONGO_PASSWORD>@127.0.0.1:27027/?authSource=admin
REDIS_URL=redis://:<ITA_REDIS_PASSWORD>@127.0.0.1:6389
# docker compose 讀取(與上面的連線字串一致)
ITA_MONGO_PASSWORD=
ITA_REDIS_PASSWORD=
# test / prod 只接受 MONGO_URL_FILE、REDIS_URL_FILE

# Agent 通道:本機 Agent 直連(不經 Nginx)時採信它自己送的 x-client-cert-* 標頭;非 dev 設定即啟動失敗
DEV_TRUST_CLIENT_HEADERS=1
# test / prod 必填:Nginx 所在 IP / 網段(逗號分隔)與 :51241 伺服器憑證(SAN 含 endpoint-server)
# AGENT_TRUSTED_PROXIES=172.16.0.0/12
# AGENT_TLS_CERT_FILE=/run/secrets/endpoint_server_crt
# AGENT_TLS_KEY_FILE=/run/secrets/endpoint_server_key

# 管理 API:本機 GigaItApp 直連時不驗證 X-Internal-Token;非 dev 設定即啟動失敗
DEV_SKIP_TOKEN=1

# Mongo 快照保留天數(預設 90)
# SNAPSHOT_RETENTION_DAYS=90
# 監控(giga-observe):dev 預設關閉
# MONITOR_ENABLED=true
# MONITOR_URL=
# MONITOR_API_KEY=
