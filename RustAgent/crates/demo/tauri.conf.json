{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "RustIt Demo",
  "version": "0.1.0",
  "identifier": "com.rustit.demo",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "RustIt 資產管理",
        "width": 1280,
        "height": 820,
        "minWidth": 980,
        "minHeight": 660,
        "center": true,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#0b1022"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png", "icons/icon.ico"]
  }
}
