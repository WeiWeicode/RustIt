{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://giganexus.local/rustit/contracts/event.schema.json",
  "title": "POST /agent/v1/events 請求",
  "description": "端點事件(PLATFORM-PLAN §4.2):Agent 先寫本機 outbox_event,連得上時批次送出,Server 確認後才從本機刪除。event_id 由 Agent 產生(UUID),Server 以 (裝置, event_id) 去重,重送不產生重複資料。occurred_at 是端點上的發生時間,Server 另記 received_at。不認得的 type 照常保存(data 原樣),供之後版本解讀。",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": { "$ref": "#/definitions/Event" }
    }
  },
  "definitions": {
    "Event": {
      "type": "object",
      "required": ["event_id", "type", "occurred_at"],
      "properties": {
        "event_id": { "type": "string", "format": "uuid" },
        "type": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,31}$" },
        "occurred_at": { "type": "string", "format": "date-time" },
        "data": { "type": "object", "description": "依 type 而定;序列化後上限 4,000 字元" }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "offline_period" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/OfflinePeriod" } } } },
        { "if": { "properties": { "type": { "enum": ["usb_inserted", "usb_removed"] } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/UsbVolume" } } } },
        { "if": { "properties": { "type": { "const": "local_overflow" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/LocalOverflow" } } } },
        { "if": { "properties": { "type": { "const": "agent_started" } } }, "then": { "properties": { "data": { "$ref": "#/definitions/AgentStarted" } } } },
        { "if": { "properties": { "type": { "const": "agent_restarted" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/AgentRestarted" } } } },
        { "if": { "properties": { "type": { "const": "agent_service_stopped" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/ServiceStopped" } } } },
        { "if": { "properties": { "type": { "const": "agent_start_type_changed" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/StartTypeChanged" } } } },
        { "if": { "properties": { "type": { "const": "agent_binary_missing" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/BinaryMissing" } } } },
        { "if": { "properties": { "type": { "const": "agent_start_failed" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/StartFailed" } } } },
        { "if": { "properties": { "type": { "const": "watchdog_stopped" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/ServiceStopped" } } } },
        { "if": { "properties": { "type": { "enum": ["agent_binary_changed", "watchdog_binary_changed"] } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/BinaryChanged" } } } },
        { "if": { "properties": { "type": { "const": "agent_pipe_impersonation" } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/PipeImpersonation" } } } },
        { "if": { "properties": { "type": { "enum": ["upgrade_started", "upgrade_succeeded", "upgrade_failed"] } } }, "then": { "required": ["data"], "properties": { "data": { "$ref": "#/definitions/Upgrade" } } } }
      ]
    },
    "BinaryChanged": {
      "description": "服務設定的程式不是預期的那支(路徑被改,P5-2):agent_binary_changed 由 Watchdog 回報(預期為 Watchdog 同目錄的 rustit-agent.exe)、watchdog_binary_changed 由 Agent 回報;同一次執行只記一次",
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": { "type": "string", "maxLength": 260 },
        "expected": { "type": "string", "maxLength": 260 }
      }
    },
    "PipeImpersonation": {
      "description": "本機管道的伺服端不是 SCM 的 Agent 行程(有人搶先建立同名管道,P5-2,指南 §7.2);Watchdog 不送出請求並中斷,同一個伺服端 PID 只記一次",
      "type": "object",
      "required": ["server_pid", "agent_pid"],
      "properties": {
        "server_pid": { "type": "integer", "minimum": 0 },
        "agent_pid": { "type": "integer", "minimum": 0 }
      }
    },
    "AgentRestarted": {
      "description": "Watchdog 偵測到 Agent 重新啟動(P5-2):crashed 行程消失後由 SCM 失敗復原或 Watchdog 重啟、hung get_status 連續 3 次失敗由 Watchdog 強制重啟、restart_command 指令 agent.restart",
      "type": "object",
      "required": ["cause"],
      "properties": {
        "cause": { "type": "string", "enum": ["crashed", "hung", "restart_command"] },
        "previous_pid": { "type": "integer", "minimum": 0 },
        "pid": { "type": "integer", "minimum": 0 }
      }
    },
    "ServiceStopped": {
      "description": "服務被手動停止(不是關機、不是 agent.restart)。agent_service_stopped:Watchdog 看到 Agent;watchdog_stopped:Agent 看到 Watchdog(P5-2)",
      "type": "object",
      "required": ["restarted"],
      "properties": {
        "state": { "type": "string", "maxLength": 32 },
        "start_type": { "type": "string", "maxLength": 16, "description": "看到時的啟動類型(被改成 disabled 時會先改回 auto)" },
        "restarted": { "type": "boolean", "description": "是否已重新啟動成功" },
        "error": { "type": "string", "maxLength": 300 }
      }
    },
    "StartTypeChanged": {
      "description": "Agent 服務的啟動類型被改掉(P5-2);Watchdog 會改回自動",
      "type": "object",
      "required": ["from", "restored"],
      "properties": {
        "from": { "type": "string", "maxLength": 16 },
        "to": { "type": "string", "maxLength": 16 },
        "restored": { "type": "boolean" },
        "error": { "type": "string", "maxLength": 300 }
      }
    },
    "BinaryMissing": {
      "description": "Agent 服務不存在或設定指向的 exe 不存在(P5-2);Watchdog 不能自己重裝,只記錄",
      "type": "object",
      "properties": {
        "service_missing": { "type": "boolean" },
        "path": { "type": "string", "maxLength": 260 }
      }
    },
    "StartFailed": {
      "description": "Watchdog 嘗試啟動 Agent 失敗(P5-2)",
      "type": "object",
      "required": ["error"],
      "properties": {
        "error": { "type": "string", "maxLength": 300 },
        "attempts": { "type": "integer", "minimum": 1 }
      }
    },
    "AgentStarted": {
      "description": "Agent 行程啟動(P2);P5 起帶上次結束原因,Server 以 previous_exit = unexpected 的筆數判斷「24 小時內非正常重啟」告警(P5-MONITOR-DESIGN §4)。0.5.0 之前的 Agent 只有 agent_version",
      "type": "object",
      "properties": {
        "agent_version": { "type": "string", "maxLength": 32 },
        "previous_exit": {
          "type": "string",
          "enum": ["stop", "shutdown", "restart_command", "unexpected", "first_run"],
          "description": "上次結束原因:stop 服務被停止、shutdown Windows 關機、restart_command 指令 agent.restart、unexpected 上次沒有正常結束(被結束行程、當掉、斷電、被 Watchdog 強制重啟)、first_run 本機暫存沒有任何執行紀錄(新安裝或暫存重建)"
        },
        "boot_time": { "type": "integer", "minimum": 0, "description": "Windows 開機時間(Unix 秒)" }
      }
    },
    "OfflinePeriod": {
      "description": "Agent 連不上主機的一段期間(主機有回應的 429 / 400 不算);恢復後送出一筆,不到 60 秒的短暫中斷不送。occurred_at = started_at。期間內 Agent 重啟(10 分鐘內)視為同一段;停止超過 10 分鐘(關機)則以最後一次嘗試結束,停止的時間不算,由主機以最後心跳判斷",
      "type": "object",
      "required": ["started_at", "ended_at", "reason", "retries"],
      "properties": {
        "started_at": { "type": "string", "format": "date-time" },
        "ended_at": { "type": "string", "format": "date-time" },
        "reason": {
          "type": "string",
          "enum": ["network", "dns", "tls", "rejected", "server_busy", "server_error", "unknown"],
          "description": "期間最主要(次數最多)的原因:network 連不上 / 逾時、dns 名稱解析失敗、tls 握手或憑證驗證失敗、rejected 主機拒絕(HTTP 401 / 403 憑證或身分;400 內容錯誤與裝置停用 / 退役(403 ITA_DEVICE_DISABLED / RETIRED、close 4403)主機有回應,不算離線)、server_busy 保留(目前 429 不算離線)、server_error 5xx"
        },
        "retries": { "type": "integer", "minimum": 0, "description": "期間失敗的連線嘗試次數" },
        "last_error": { "type": "string", "maxLength": 300, "description": "最後一次錯誤摘要(不含個資與憑證內容)" }
      }
    },
    "UsbVolume": {
      "description": "USB 儲存裝置(可移除磁碟區)插入或移除",
      "type": "object",
      "required": ["drive"],
      "properties": {
        "drive": { "type": "string", "description": "磁碟機代號,例 E:" },
        "label": { "type": "string" },
        "file_system": { "type": "string" },
        "total": { "type": "integer", "minimum": 0, "description": "容量(位元組)" },
        "serial": { "type": "string", "description": "磁碟區序號(十六進位)" }
      }
    },
    "LocalOverflow": {
      "description": "本機暫存達上限,丟棄最舊的資料",
      "type": "object",
      "required": ["store", "dropped"],
      "properties": {
        "store": { "type": "string", "enum": ["outbox_inventory", "outbox_event"] },
        "dropped": { "type": "integer", "minimum": 1 }
      }
    },
    "Upgrade": {
      "description": "升級事件(P6,P6-UPGRADE-DESIGN §2.3):Watchdog 升級 Agent 經 watchdog/report 上報(component = agent),Agent 替換 Watchdog 經 /agent/v1/events 上報(component = watchdog);主機依路徑檢查 component,不符略過",
      "type": "object",
      "required": ["component", "to"],
      "properties": {
        "component": { "type": "string", "enum": ["agent", "watchdog"] },
        "from": { "type": "string", "maxLength": 32, "description": "升級前版本" },
        "to": { "type": "string", "maxLength": 32, "description": "目標版本" },
        "duration_ms": { "type": "integer", "minimum": 0, "description": "upgrade_succeeded / upgrade_failed:從開始(下載)到結束" },
        "error_code": { "$ref": "#/definitions/UpgradeErrorCode" },
        "error_message": { "type": "string", "maxLength": 300 },
        "rolled_back": { "type": "boolean", "description": "upgrade_failed:已還原為舊版並確認正常" }
      }
    },
    "UpgradeErrorCode": {
      "type": "string",
      "enum": [
        "DOWNLOAD_FAILED",
        "HASH_MISMATCH",
        "SIGNATURE_INVALID",
        "SIGNER_NOT_TRUSTED",
        "PREPARE_TIMEOUT",
        "STOP_TIMEOUT",
        "REPLACE_FAILED",
        "HEALTH_CHECK_FAILED",
        "ROLLBACK_FAILED",
        "DISK_FULL"
      ]
    },
    "EventsResponse": {
      "title": "POST /agent/v1/events 回應(200)",
      "description": "accepted:已保存(含先前已收過)的 event_id,Agent 據此從本機刪除",
      "type": "object",
      "required": ["accepted"],
      "properties": {
        "accepted": { "type": "array", "items": { "type": "string", "format": "uuid" } },
        "server_time": { "type": "string", "format": "date-time" }
      }
    }
  }
}
